# hpc-batch job dispatch daemon.
#
# Install:  cp systemd/hpc-batch.service /etc/systemd/system/
#           systemctl daemon-reload && systemctl enable --now hpc-batch
#
# Admin parameters are passed as arguments to hpc-batchd below.
# After editing them: systemctl daemon-reload && systemctl reload hpc-batch
# (reload re-execs the daemon in place -- running jobs are NOT killed).

[Unit]
Description=hpc-batch job dispatch daemon
Documentation=https://github.com/yiannis/hpc-batch
After=local-fs.target

[Service]
Type=simple
# Adjust the path if hpc-batchd was installed elsewhere (e.g. via pipx).
ExecStart=/usr/local/bin/hpc-batchd --max-lifetime 24h --admin-group wheel
ExecReload=/bin/kill -HUP $MAINPID

# Jobs live in /sys/fs/cgroup/hpc-batch, which the daemon creates and owns,
# NOT under this unit. Delegate= here would nest them in the service cgroup,
# and surviving jobs would then make it impossible to restart: cgroup v2
# refuses to hold a process in a cgroup whose children have controllers
# enabled, so systemd would fail every start with 219/CGROUP until the last
# job exited. Keeping the service cgroup a leaf is what makes it restartable.
#
# Covers the daemon only, for the same reason. Jobs get memory.swap.max=0
# written into their own cgroup: swapping would wreck benchmark timings.
MemorySwapMax=0
# Only kill the daemon itself on stop/restart; jobs keep running and are
# re-adopted when the daemon comes back.
KillMode=process

# /run/hpc-batch (socket) and /var/lib/hpc-batch (state + job output).
RuntimeDirectory=hpc-batch
RuntimeDirectoryPreserve=yes
StateDirectory=hpc-batch

Restart=on-failure
RestartSec=2
OOMScoreAdjust=-500

[Install]
WantedBy=multi-user.target
