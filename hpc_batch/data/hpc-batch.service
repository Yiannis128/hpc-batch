# hpc-batch job dispatch daemon. Written here by `hpc-batch-install`, which
# fills in the daemon path and an admin group that exists on this system.
#
# Admin parameters are the arguments to hpc-batchd below; edit them freely.
# After editing: systemctl daemon-reload && systemctl reload hpc-batch
# (reload re-execs the daemon in place -- running jobs are NOT killed).
# Rerunning hpc-batch-install rewrites this file, so keep local changes in a
# drop-in instead: systemctl edit hpc-batch.

[Unit]
Description=hpc-batch job dispatch daemon
Documentation=https://github.com/Yiannis128/hpc-batch
After=local-fs.target

[Service]
Type=simple
ExecStart=@HPC_BATCHD@ --max-lifetime 24h --admin-group @ADMIN_GROUP@
ExecReload=/bin/kill -HUP $MAINPID

# Jobs live in /sys/fs/cgroup/hpc-batch, which the daemon creates and owns,
# not under this unit: the service cgroup holds only the daemon, so it empties
# on stop and systemd can always recreate it, even while jobs from the previous
# daemon are still running. Delegate= is still needed, not to nest anything
# under the unit but because it is what makes systemd enable cpuset and memory
# at the cgroup root, where our tree inherits them from.
Delegate=cpuset memory pids

# The daemon only; jobs get memory.swap.max=0 in their own cgroup.
MemorySwapMax=0
# Only kill the daemon itself on stop/restart; jobs keep running and are
# re-adopted when the daemon comes back.
KillMode=process

# /run/hpc-batch (socket) and /var/lib/hpc-batch (state + job output).
RuntimeDirectory=hpc-batch
RuntimeDirectoryPreserve=yes
StateDirectory=hpc-batch

Restart=on-failure
RestartSec=2
# 78 is EX_CONFIG: the daemon refusing to start because it was asked for
# isolation it cannot deliver. Restarting cannot fix that, and looping buries
# the one log line that says what is wrong.
RestartPreventExitStatus=78
OOMScoreAdjust=-500

[Install]
WantedBy=multi-user.target
